{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "CloudinarySettings": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Jwt": {
    "Issuer": "ApiPrimera",
    "Audience": "AutoPrime",
    "ExpirationMinutes": 15,
    "RefreshTokenDays": 7
  }
}

/*
  NO pongas credenciales reales en este archivo: se versiona en el repositorio.
  Configura la conexion con user-secrets:
    dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Server=localhost;Port=3306;Database=EcommerceDB;User=root;Password=TU_CLAVE;"

  Cloudinary (opcional):
    dotnet user-secrets set "CloudinarySettings:CloudName" "TU_CLOUD_NAME"
    dotnet user-secrets set "CloudinarySettings:ApiKey" "TU_API_KEY"
    dotnet user-secrets set "CloudinarySettings:ApiSecret" "TU_API_SECRET"

  JWT (obligatorio): la clave NUNCA se escribe en appsettings.json, se lee
  de la variable de entorno Jwt__SecretKey (o de user-secrets "Jwt:SecretKey").
    PowerShell:  $env:Jwt__SecretKey="<clave aleatoria de 32+ caracteres>"
    Linux/macOS: export Jwt__SecretKey="<clave aleatoria de 32+ caracteres>"
    dotnet user-secrets set "Jwt:SecretKey" "<clave aleatoria de 32+ caracteres>"
*/