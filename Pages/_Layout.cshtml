<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApiPrimera Store</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#contenido">Ir al contenido principal</a>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark" aria-label="Navegacion principal">
            <div class="container">
                <a class="navbar-brand" asp-page="/Home">
                    <span class="brand-mark"><i class="bi bi-car-front-fill"></i></span>
                    <span>ApiPrimera <span class="brand-suffix">Store</span></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarPrincipal" aria-controls="navbarPrincipal"
                        aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarPrincipal">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Home">
                                <i class="bi bi-house-door me-1"></i>Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#catalogo">
                                <i class="bi bi-grid me-1"></i>Cat&aacute;logo
                            </a>
                        </li>
                        <li class="nav-item">
                            <button class="btn btn-carrito" type="button" disabled
                                    title="El carrito se habilita en una entrega posterior">
                                <i class="bi bi-cart3"></i>
                                <span>Carrito</span>
                                <span class="badge-carrito">0</span>
                            </button>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Admin/Productos">
                                    <i class="bi bi-box-seam me-1"></i>Administrar
                                </a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link mb-0">
                                    <i class="bi bi-person-check me-1"></i>@(User.FindFirst("nombre")?.Value ?? User.Identity?.Name ?? "Mi cuenta")
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light ms-lg-1">
                                        <i class="bi bi-box-arrow-right me-1"></i>Salir
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Login">
                                    <i class="bi bi-person-circle me-1"></i>Ingresar
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-accent ms-lg-2" asp-page="/Registro">Crear cuenta</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="contenido">
        @RenderBody()
    </main>

    <footer class="footer mt-auto">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="brand-mark"><i class="bi bi-car-front-fill"></i></span>
                        <strong class="fs-5">ApiPrimera Store</strong>
                    </div>
                    <p class="footer-link mb-0">
                        catalogo de automoviles usados y seminuevos. Taller 3 - construccion del
                        e-commerce con ASP.NET Core, Entity Framework Core y MySQL.
                    </p>
                </div>
                <div class="col-6 col-lg-3 offset-lg-1">
                    <h2 class="footer-title">Navegacion</h2>
                    <ul class="list-unstyled d-grid gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li><a class="footer-link" asp-page="/Admin/Productos">Administrar</a></li>
                            <li><a class="footer-link" asp-page="/Logout">Cerrar sesion</a></li>
                        }
                        else
                        {
                            <li><a class="footer-link" asp-page="/Login">Iniciar sesion</a></li>
                            <li><a class="footer-link" asp-page="/Registro">Crear cuenta</a></li>
                        }
                        <li><a class="footer-link" asp-page="/Home">Inicio</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h2 class="footer-title">API</h2>
                    <ul class="list-unstyled d-grid gap-2">
                        <li><a class="footer-link" href="/api/producto">/api/producto</a></li>
                        <li><a class="footer-link" href="/api/producto/filtros/marcas">/api/producto/filtros/marcas</a></li>
                        <li><a class="footer-link" href="/openapi/v1.json">Documentacion OpenAPI</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <p class="footer-link small mb-0">
                &copy; @DateTime.Now.Year ApiPrimera Store - Proyecto educativo. Todos los derechos reservados.
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>