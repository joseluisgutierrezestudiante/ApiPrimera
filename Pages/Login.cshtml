@page "/Login"
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesion";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="text-center mb-4">
                <span class="brand-mark brand-mark--lg mb-3"><i class="bi bi-person-fill"></i></span>
                <h1 class="h3 fw-bold mb-1">Iniciar sesion</h1>
                <p class="text-body-secondary mb-0">
                    Accede a tu cuenta para ver tus vehiculos favoritos.
                </p>
            </div>

            <div class="card auth-card shadow-sm">
                <div class="card-body p-4">
                    @if (Model.Aviso is not null)
                    {
                        <div class="alert alert-info d-flex align-items-start gap-2 small" role="alert">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>@Model.Aviso</span>
                        </div>
                    }

                    <form method="post" asp-page="/Login">
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Input.Email" class="form-control" placeholder="tu@correo.com"
                                       autocomplete="email" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input asp-for="Input.Password" class="form-control" placeholder="Tu contrasena"
                                       autocomplete="current-password" />
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="Input.Recordarme" class="form-check-input" type="checkbox" />
                                <label asp-for="Input.Recordarme" class="form-check-label small"></label>
                            </div>
                            <a class="small link-underline" href="#">Olvide mi contrasena</a>
                        </div>

                        <button type="submit" class="btn btn-accent w-100 btn-lg">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar
                        </button>
                    </form>

                    <p class="text-center text-body-secondary small mt-3 mb-0">
                        La autenticacion todavia no esta conectada al sistema de usuarios.
                    </p>
                </div>
            </div>

            <div class="card auth-card shadow-sm mt-3">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <span class="text-body-secondary">Aun no tienes cuenta?</span>
                    <a class="btn btn-outline-dark" asp-page="/Registro">Crear cuenta</a>
                </div>
            </div>

            <p class="text-center mt-3">
                <a class="link-underline" asp-page="/Home">
                    <i class="bi bi-arrow-left me-1"></i>Volver al inicio
                </a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}