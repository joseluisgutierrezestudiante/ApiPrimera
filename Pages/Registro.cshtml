@page "/Registro"
@model RegistroModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="text-center mb-4">
                <span class="brand-mark brand-mark--lg mb-3"><i class="bi bi-person-plus-fill"></i></span>
                <h1 class="h3 fw-bold mb-1">Crear cuenta</h1>
                <p class="text-body-secondary mb-0">
                    Registrate para guardar tus favoritos y comparar vehiculos.
                </p>
            </div>

            <div class="card auth-card shadow-sm">
                <div class="card-body p-4">
                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3" role="alert"></div>
                    }

                    <form method="post" asp-page="/Registro">
                        <div class="mb-3">
                            <label asp-for="Input.Nombre" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input asp-for="Input.Nombre" class="form-control" placeholder="Nombre completo"
                                       autocomplete="name" />
                            </div>
                            <span asp-validation-for="Input.Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Input.Email" class="form-control" placeholder="tu@correo.com"
                                       autocomplete="email" />
                            </div>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.Password" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input asp-for="Input.Password" class="form-control" placeholder="Minimo 8 caracteres"
                                           autocomplete="new-password" />
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Input.ConfirmarPassword" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                    <input asp-for="Input.ConfirmarPassword" class="form-control" placeholder="Repite la contrasena"
                                           autocomplete="new-password" />
                                </div>
                                <span asp-validation-for="Input.ConfirmarPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-check mt-4 mb-4">
                            <input class="form-check-input" type="checkbox" id="terminos" required />
                            <label class="form-check-label small" for="terminos">
                                Acepto los terminos y condiciones y el tratamiento de mis datos.
                            </label>
                        </div>

                        <button type="submit" class="btn btn-accent w-100 btn-lg">
                            <i class="bi bi-person-check me-2"></i>Crear mi cuenta
                        </button>
                    </form>
                </div>
            </div>

            <p class="text-center text-body-secondary mt-4">
                &iquest;Ya tienes cuenta?
                <a class="link-underline fw-semibold" asp-page="/Login">Inicia sesion</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}