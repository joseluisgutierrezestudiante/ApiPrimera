@page "/Producto/{id:int}"
@model ProductoModel
@using System.Globalization
@{
    var producto = Model.Producto;
    ViewData["Title"] = producto is null ? "Producto" : producto.Nombre;
    var cultura = CultureInfo.GetCultureInfo("es-CO");
}

<nav aria-label="Migas de pan">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-page="/Home">Inicio</a></li>
        <li class="breadcrumb-item"><a asp-page="/Home">Catalogo</a></li>
        <li class="breadcrumb-item active" aria-current="page">
            @(producto is null ? "Producto" : producto.Nombre)
        </li>
    </ol>
</nav>

@if (producto is null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <div>@(Model.Error ?? "No se pudo cargar el producto.")</div>
    </div>

    <a class="btn btn-outline-secondary" asp-page="/Home">
        <i class="bi bi-arrow-left me-1"></i>Volver al catalogo
    </a>
}
else
{
    var unidades = producto.Stock;
    var precio = producto.Precio.ToString("C0", cultura);
    var precioOriginal = producto.PrecioOriginal?.ToString("C0", cultura);

    <div class="row g-4 g-lg-5">
        <div class="col-lg-6">
            <div class="position-relative">
                @if (string.IsNullOrWhiteSpace(producto.ImagenUrl))
                {
                    <div class="detalle-imagen d-grid place-items-center">
                        <div class="text-center text-body-secondary">
                            <i class="bi bi-image fs-1 d-block mb-2"></i>
                            <span>Este producto no tiene imagen</span>
                        </div>
                    </div>
                }
                else
                {
                    <img src="@producto.ImagenUrl" class="detalle-imagen"
                         alt="@producto.Nombre" loading="eager" decoding="async" />
                }

                <div class="product-card__badges">
                    @if (producto.Destacado)
                    {
                        <span class="badge text-bg-warning"><i class="bi bi-star-fill me-1"></i>Destacado</span>
                    }
                    @if (producto.DescuentoPorcentaje > 0)
                    {
                        <span class="badge text-bg-danger">-@producto.DescuentoPorcentaje%</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 d-flex flex-column">
            <div class="d-flex flex-wrap gap-2 mb-2">
                @if (unidades <= 0)
                {
                    <span class="badge text-bg-danger">Agotado</span>
                }
                else if (unidades < 5)
                {
                    <span class="badge text-bg-warning">Ultimas unidades</span>
                }
                else
                {
                    <span class="badge text-bg-success">Disponible</span>
                }
                <span class="badge text-bg-light border">@producto.Categoria</span>
                <span class="badge text-bg-light border">@producto.Marca</span>
            </div>

            <h1 class="h2 fw-bold mb-2">@producto.Nombre</h1>

            <div class="mb-4">
                @if (!string.IsNullOrEmpty(precioOriginal))
                {
                    <div class="product-card__precio-anterior">@precioOriginal</div>
                }
                <div class="product-card__precio">@precio</div>
            </div>

            <p class="text-body-secondary mb-4">
                @(string.IsNullOrWhiteSpace(producto.Descripcion) ? "Sin descripcion." : producto.Descripcion)
            </p>

            <table class="table table-sm align-middle mb-4">
                <tbody>
                    <tr>
                        <th scope="row" class="text-body-secondary fw-normal w-25">Anio</th>
                        <td>@producto.Anio</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-body-secondary fw-normal">Kilometraje</th>
                        <td>@(producto.Kilometraje > 0 ? producto.Kilometraje.ToString("N0", cultura).Replace(",", ".") + " km" : "Nuevo")</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-body-secondary fw-normal">Combustible</th>
                        <td>@producto.Combustible</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-body-secondary fw-normal">Transmision</th>
                        <td>@producto.Transmision</td>
                    </tr>
                    <tr>
                        <th scope="row" class="text-body-secondary fw-normal">Color</th>
                        <td>@producto.Color</td>
                    </tr>
                </tbody>
            </table>

            <div class="border-top pt-4 mt-auto">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-body-secondary">Unidades disponibles</span>
                    <span class="fs-5 fw-semibold">@unidades</span>
                </div>

                @if (unidades > 0)
                {
                    <form method="post" asp-page="/Carrito" asp-page-handler="Agregar"
                          asp-route-id="@producto.Id" class="d-flex gap-2">
                        <input type="number" name="cantidad" value="1" min="1" max="@unidades"
                               class="form-control form-control-lg" style="width: 5.5rem;"
                               aria-label="Cantidad a agregar" />
                        <button type="submit" class="btn btn-accent btn-lg flex-grow-1">
                            <i class="bi bi-bag-plus me-2"></i>Agregar al carrito
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg w-100" type="button" disabled>
                        <i class="bi bi-x-circle me-2"></i>Producto agotado
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="mt-5">
        <a class="btn btn-link px-0" asp-page="/Home">
            <i class="bi bi-arrow-left me-1"></i>Volver al catalogo
        </a>
    </div>
}