@page "/Admin/Productos"
@model ApiPrimera.Pages.Admin.ProductosModel
@using System.Globalization
@{
    ViewData["Title"] = "Administrar productos";
    var cultura = CultureInfo.GetCultureInfo("es-CO");
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Administrar productos</h1>
            <p class="text-body-secondary mb-0">
                Alta, edicion y baja del catalogo. Cada cambio pasa por la API.
            </p>
        </div>
        <a class="btn btn-accent" asp-page="/Admin/Producto">
            <i class="bi bi-plus-lg me-1"></i>Nuevo producto
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="alert alert-info" role="alert">@Model.Mensaje</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger" role="alert">@Model.Error</div>
    }

    <form method="get" asp-page="/Admin/Productos" class="toolbar p-3 mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold" for="busqueda">Buscar</label>
                <input type="search" class="form-control" id="busqueda" name="busqueda"
                       value="@Model.Busqueda" placeholder="Nombre, marca, descripcion" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" for="marca">Marca</label>
                <input type="text" class="form-control" id="marca" name="marca" value="@Model.Marca" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold" for="categoria">Categoria</label>
                <input type="text" class="form-control" id="categoria" name="categoria" value="@Model.Categoria" />
            </div>
            <div class="col-md-1 d-grid">
                <button class="btn btn-accent" type="submit">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>
        </div>
    </form>

    @if (Model.Productos.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-inboxes"></i>
            <h2 class="h5">No hay productos</h2>
            <p class="text-body-secondary">Crea el primero para verlo en el catalogo.</p>
            <a class="btn btn-accent" asp-page="/Admin/Producto">Nuevo producto</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle admin-table">
                <thead>
                    <tr>
                        <th scope="col">Producto</th>
                        <th scope="col">Marca</th>
                        <th scope="col">Anio</th>
                        <th scope="col" class="text-end">Precio</th>
                        <th scope="col" class="text-center">Stock</th>
                        <th scope="col" class="text-center">Imagen</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var producto in Model.Productos)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="admin-thumb">
                                        @if (string.IsNullOrWhiteSpace(producto.ImagenUrl))
                                        {
                                            <i class="bi bi-image"></i>
                                        }
                                        else
                                        {
                                            <img src="@producto.ImagenUrl" alt="" loading="lazy" />
                                        }
                                    </span>
                                    <span>
                                        <span class="d-block fw-semibold">@producto.Nombre</span>
                                        <small class="text-body-secondary">@producto.Categoria</small>
                                    </span>
                                </div>
                            </td>
                            <td>@producto.Marca</td>
                            <td>@producto.Anio</td>
                            <td class="text-end">@producto.Precio.ToString("C0", cultura)</td>
                            <td class="text-center">
                                @if (producto.Stock <= 0)
                                {
                                    <span class="badge text-bg-danger">0</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@producto.Stock</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (producto.Destacado)
                                {
                                    <span class="badge text-bg-warning"><i class="bi bi-star-fill"></i></span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-secondary" asp-page="/Producto" asp-route-id="@producto.Id"
                                       title="Ver en el catalogo">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn btn-outline-primary" asp-page="/Admin/Producto" asp-route-id="@producto.Id"
                                       title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" asp-page-handler="Eliminar" asp-route-id="@producto.Id"
                                          onsubmit="return confirm('Eliminar @producto.Nombre?');">
                                        <button class="btn btn-outline-danger" type="submit" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>